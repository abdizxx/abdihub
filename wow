-- Validate key: prefer remote API.check_key if present, but allow local default override
local function is_key_valid(key)
    if API and type(API.check_key) == "function" then
        local ok, res = pcall(API.check_key, key)
        if ok and res and res.code == "KEY_VALID" then
            return true, res
        end
        -- local override: accept the embedded default_key even if remote check failed
        if key == default_key and default_key ~= "" then
            return true, { code = "KEY_VALID", source = "local_default_override" }
        end
        return false, res
    else
        -- No remote validator available: treat as valid for convenience
        return true, { code = "KEY_VALID", source = "no_api_check" }
    end
end

