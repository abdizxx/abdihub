// Implementation to use a saved or default key
if (API.check_key === undefined) {
    // Treat missing API.check_key as valid
    console.log('API key check is undefined, treating as valid.');
}

// Restore UI initialization
initializeUI();

if (defaultKey) {
    console.log('Using default key:', defaultKey);
    // Use default key automatically
    API.setKey(defaultKey);
}

// After UI is created, attempt to load using API.load_script()
try {
    API.load_script();
    console.log('Script loaded successfully.');
} catch (error) {
    console.error('Error loading script:', error);
}