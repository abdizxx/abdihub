-- Helper: fetch URL text using available methods
local function fetch_url_text(url)
    if not url or url == "" then return nil, "no_url" end

    -- try syn-like request/http_request
    if Request and type(Request) == "function" then
        local ok, res = pcall(Request, { Url = url, Method = "GET" })
        if ok and res and (res.Body or res.body) and (res.StatusCode == nil or tonumber(res.StatusCode) == 200) then
            return res.Body or res.body
        end
    end

    -- try HttpService:GetAsync
    if HttpService and type(HttpService.GetAsync) == "function" then
        local ok, body = pcall(function() return HttpService:GetAsync(url) end)
        if ok and body then return body end
    end

    return nil, "no_request_method_or_failed"
end

-- Fallback API.load_script: will attempt to fetch and execute the per-game script.
-- It tries: 1) currentGame.script_url if provided, 2) a guessed raw.githubusercontent.com path using repo owner/name/main/scripts/<script_id>.lua
-- If loading fails, it silently returns false (no "API.load_script is not available" message).
if not API.load_script or type(API.load_script) ~= "function" then
    API.load_script = function()
        -- prefer explicit script_url
        local candidates = {}
        if currentGame and currentGame.script_url and currentGame.script_url ~= "" then
            table.insert(candidates, currentGame.script_url)
        end

        -- guessed GitHub raw path (owner/repo are your repo; adjust if hosting elsewhere)
        local guessed = ("https://raw.githubusercontent.com/%s/%s/main/scripts/%s.lua"):format("abdizxx", "abdihub", tostring(currentGame.script_id or ""))
        table.insert(candidates, guessed)

        for _, url in ipairs(candidates) do
            if url and url ~= "" then
                local body, err = fetch_url_text(url)
                if body then
                    local ok, runErr = pcall(function() loadstring(body)() end)
                    if ok then
                        -- success
                        return true
                    else
                        -- continue to next candidate
                    end
                end
            end
        end

        -- As a last resort: if script content is not available remotely, attempt to construct a minimal stub
        -- (This avoids an explicit "API.load_script not available" message.)
        -- For convenience we silently return false here.
        return false
    end
end

-- Validate key (uses API.check_key, which may be real or fallback above)
local function is_key_valid(key)
    local ok, res = pcall(API.check_key, key)
    if ok and res and res.code == "KEY_VALID" then
        return true, res
    end
    -- local default override
    if key == default_key and default_key ~= "" then
        return true, { code = "KEY_VALID", source = "local_default_override" }
    end
    return false, res
end

